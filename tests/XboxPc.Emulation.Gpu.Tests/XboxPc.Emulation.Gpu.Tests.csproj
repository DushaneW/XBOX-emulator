<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-GPU (Direct3D 12) renderer tests: render the bundled test programs on the GPU and compare with the CPU reference renderer. -->
  <PropertyGroup>
    <TargetFramework>$(XpcTfm)-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XboxPc.Emulation.OriginalXbox\XboxPc.Emulation.OriginalXbox.csproj" />
    <ProjectReference Include="..\..\src\XboxPc.Emulation.Gpu.D3D12\XboxPc.Emulation.Gpu.D3D12.csproj" />
  </ItemGroup>
  <ItemGroup><Using Include="Xunit" /></ItemGroup>
  <ItemGroup>
    <None Include="..\XboxPc.Emulation.Tests\Assets\xpc-*\**" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
