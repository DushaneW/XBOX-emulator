<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(XpcTfm)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- xUnit test classes are public by convention; CA1707 underscores in test names are intentional -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XboxPc.DesktopApp\XboxPc.DesktopApp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\samples\*.xpct" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Using Include="Xunit" /><Using Include="System.IO" /></ItemGroup>
</Project>

