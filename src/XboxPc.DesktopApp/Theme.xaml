<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:XboxPc.DesktopApp">
    <app:VisibilityConverter x:Key="Vis" />
    <app:SafeImageConverter x:Key="Img" />
    <app:EqualsVisibilityConverter x:Key="Eq" />
    <app:EqualsBoolConverter x:Key="EqB" />
    <app:ScaleConverter x:Key="Scale" />
    <app:FractionWidthConverter x:Key="Frac" />
    <app:SameMultiConverter x:Key="Same" />
    <!--
        XBOX PC console theme.
        Near-black base, charcoal surfaces, almost no borders: hierarchy comes from light, size and spacing.
        Green is used for three things only: the Play action, the active navigation marker and "running" state.
        Focus is the console idiom: a white ring and a slight enlargement of the focused item.
        Motion: Fast 140 ms (hover/press), Base 240 ms (focus, tabs), Slow 420 ms (pages, overlays); ease-out quart.
    -->
    <Color x:Key="VoidColor">#050607</Color>
    <Color x:Key="BgColor">#0A0C0E</Color>
    <Color x:Key="SurfaceColor">#121518</Color>
    <Color x:Key="CardColor">#191D21</Color>
    <Color x:Key="CardHoverColor">#22272C</Color>
    <Color x:Key="AccentColor">#4FC36D</Color>
    <Color x:Key="Accent2Color">#E3B04B</Color>
    <Color x:Key="TextColor">#F2F4F5</Color>
    <Color x:Key="MutedColor">#99A2AA</Color>
    <Color x:Key="FaintColor">#5F676F</Color>
    <Color x:Key="WarnColor">#E3B04B</Color>
    <Color x:Key="DangerColor">#E5606E</Color>
    <Color x:Key="OkColor">#4FC36D</Color>
    <Color x:Key="LineColor">#22272C</Color>

    <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}" />
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C4FC36D" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#1FE3B04B" />
    <SolidColorBrush x:Key="SlateSoftBrush" Color="#1A99A2AA" />
    <SolidColorBrush x:Key="DotGridBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#15191D" Offset="0" />
        <GradientStop Color="#0F1215" Offset="1" />
    </LinearGradientBrush>
    <!-- Scrim that keeps text legible over artwork -->
    <LinearGradientBrush x:Key="ScrimLeft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F20A0C0E" Offset="0" />
        <GradientStop Color="#C00A0C0E" Offset="0.45" />
        <GradientStop Color="#000A0C0E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrimBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000A0C0E" Offset="0" />
        <GradientStop Color="#FF0A0C0E" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Duration x:Key="MotionFast">0:0:0.14</Duration>
    <Duration x:Key="MotionBase">0:0:0.24</Duration>
    <Duration x:Key="MotionSlow">0:0:0.42</Duration>
    <QuarticEase x:Key="EaseOut" EasingMode="EaseOut" />

    <!-- Focus: white ring, always visible for keyboard and controller -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" RadiusX="8" RadiusY="8" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Control}" x:Key="BaseControl">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ===================== Type ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="50" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,22,0,12" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
        <Setter Property="Margin" Value="0,12,0,5" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource SlateSoftBrush}" />
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" />
                        <Border x:Name="Light" CornerRadius="5" Background="#16FFFFFF" Opacity="0" />
                        <Rectangle x:Name="Ring" Margin="-3" RadiusX="7" RadiusY="7" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionBase}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionFast}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Light" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Play / primary: the one green action on a screen -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#06120A" />
    </Style>
    <!-- White: the strong neutral action (console style) -->
    <Style x:Key="SolidButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#F2F4F5" />
        <Setter Property="Foreground" Value="#0A0C0E" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <!-- Icon-only round button -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#10FFFFFF" />
    </Style>

    <!-- Text-only action (See all, status line links) -->
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Ring" Margin="-6,-3" RadiusX="5" RadiusY="5" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Cover tile (DataContext: GameTile). Portrait art (1 : 1.4, a game case), or, without art, the title's
        initials set large on charcoal. Focus: white ring, 6 % enlargement, title turns white.
    -->
    <Style x:Key="CoverTile" TargetType="Button" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Width" Value="176" />
        <Setter Property="Margin" Value="0,0,22,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel x:Name="Root" RenderTransformOrigin="0.5,0.35" Background="Transparent">
                        <StackPanel.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></StackPanel.RenderTransform>
                        <Grid x:Name="ArtBox" Height="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Scale}, ConverterParameter=1.4}">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22272C" Offset="0" />
                                        <GradientStop Color="#15181B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <TextBlock Text="{Binding Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="56" FontWeight="Bold" Foreground="#2E353B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding GenerationText}" Style="{StaticResource Eyebrow}" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="12,0,12,12" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CoverPath, Converter={StaticResource Img}, ConverterParameter=420}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border x:Name="Shade" CornerRadius="6" Background="#33000000" />
                            <Border Background="#CC0A0C0E" CornerRadius="10" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                    Visibility="{Binding IsFavorite, Converter={StaticResource Vis}}">
                                <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{StaticResource Accent2Brush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Rectangle x:Name="Ring" Margin="-4" RadiusX="9" RadiusY="9" Stroke="{StaticResource FocusBrush}" StrokeThickness="3" Opacity="0" />
                        </Grid>
                        <TextBlock x:Name="TitleText" Text="{Binding Name}" Margin="2,12,2,0" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding PlayedAgo}" Margin="2,3,2,0" FontSize="12" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shade" Property="Background" Value="Transparent" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shade" Property="Background" Value="Transparent" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionFast}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section heading row in pages: title + optional count -->
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Horizontal tile row: no visible scrollbar; focus scrolls it -->
    <Style x:Key="TileRow" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="6,8,6,10" />
        <Setter Property="Margin" Value="-6,0,-6,0" />
    </Style>

    <!-- Top navigation tab: text only; the active tab gets a green underline that grows from the centre -->
    <Style x:Key="NavItem" TargetType="RadioButton" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill" CornerRadius="5" Background="#14FFFFFF" Opacity="0" />
                        <Rectangle x:Name="Ring" RadiusX="6" RadiusY="6" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter Margin="16,10,16,12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Rectangle x:Name="Bar" Height="3" Width="22" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{StaticResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="0" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionBase}" EasingFunction="{StaticResource EaseOut}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleX" To="0" Duration="{StaticResource MotionFast}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionFast}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionBase}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical section list (Settings): active item is white with a green marker -->
    <Style x:Key="SideItem" TargetType="RadioButton" BasedOn="{StaticResource BaseControl}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" />
                        <Rectangle x:Name="Ring" RadiusX="7" RadiusY="7" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <Rectangle x:Name="Bar" Width="3" Margin="0,10" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Opacity="0" />
                        <ContentPresenter Margin="18,11" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" /><Setter TargetName="Bar" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A settings row: title and explanation on the left, the control on the right -->
    <Style x:Key="SettingRow" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="LastChildFill" Value="True" />
    </Style>
    <Style x:Key="SettingTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SettingNote" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,24,0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,10,0,18" />
    </Style>

    <!-- Section switch inside a page (Settings, filters): pill segments -->
    <Style x:Key="SegmentItem" TargetType="RadioButton" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="16" Background="#0DFFFFFF" />
                        <Rectangle x:Name="Ring" Margin="-3" RadiusX="18" RadiusY="18" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter Margin="16,7" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F2F4F5" />
                            <Setter Property="Foreground" Value="#0A0C0E" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="#0A0C0E" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- On/off chip (favourites filter, overlay toggles) -->
    <Style x:Key="ToggleChip" TargetType="ToggleButton" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="16" Background="#0DFFFFFF" />
                        <Rectangle x:Name="Ring" Margin="-3" RadiusX="18" RadiusY="18" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <ContentPresenter Margin="16,7" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F2F4F5" />
                            <Setter Property="Foreground" Value="#0A0C0E" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Inputs ===================== -->
    <Style TargetType="TextBox" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch (CheckBox) -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource BaseControl}">
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" Background="#2A3036" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="#C9CED3" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="KnobX" X="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                            <Rectangle x:Name="Ring" Margin="-4" RadiusX="15" RadiusY="15" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="18" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="{StaticResource MotionFast}" EasingFunction="{StaticResource EaseOut}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="#06120A" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource BaseControl}" />
    <Style TargetType="Expander" BasedOn="{StaticResource BaseControl}" />

    <!-- Slider: thin track, green fill, white thumb -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="E" Width="18" Height="18" Fill="#F2F4F5" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="E" Property="Width" Value="20" /><Setter TargetName="E" Property="Height" Value="20" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource BaseControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="26">
                        <Rectangle x:Name="Ring" Margin="-6,-2" RadiusX="8" RadiusY="8" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="#2A3036" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource SliderThumb}" /></Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: dark field with a dark drop-down -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource CardBrush}" CornerRadius="5">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource BaseControl}">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" />
                        <ContentPresenter Margin="12,8,34,8" IsHitTestVisible="False" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Rectangle x:Name="Ring" Margin="-3" RadiusX="7" RadiusY="7" Stroke="{StaticResource FocusBrush}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#1E2328" CornerRadius="6" Padding="4" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="1" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource BaseControl}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="4" Padding="10,7" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2A3036" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F2F4F5" /><Setter Property="Foreground" Value="#0A0C0E" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin, quiet scroll bars -->
    <Style x:Key="BarThumb" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#3A4148" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4">
                        <Track.Thumb><Thumb Style="{StaticResource BarThumb}" /></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="6" />
                <Setter Property="MinHeight" Value="6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="4,0">
                                <Track.Thumb><Thumb Style="{StaticResource BarThumb}" /></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#1E2328" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="340" />
    </Style>
</ResourceDictionary>
