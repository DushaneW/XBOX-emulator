<Window x:Class="XboxPc.DesktopApp.SplashWindow" Foreground="{StaticResource TextBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XBOX PC" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="Black" ShowInTaskbar="True" UseLayoutRounding="True" Cursor="None"
        FontFamily="{StaticResource BodyFont}">
    <Grid x:Name="Root">
        <!-- Ambient glow behind the mark; breathes once when the light passes -->
        <Ellipse x:Name="Glow" Width="760" Height="760" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#334FC36D" Offset="0" />
                    <GradientStop Color="#0F4FC36D" Offset="0.38" />
                    <GradientStop Color="#004FC36D" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel x:Name="Logo" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0">
            <!-- The XBOX PC aperture: four bars turning around an open centre -->
            <Canvas x:Name="Mark" Width="120" Height="120" HorizontalAlignment="Center">
                <!-- Stroke: a gradient brush with a moving highlight, created in code (the light sweep) -->
                <Line x:Name="Bar1" X1="23" Y1="13" X2="53" Y2="43" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line x:Name="Bar2" X1="107" Y1="23" X2="77" Y2="53" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line x:Name="Bar3" X1="97" Y1="107" X2="67" Y2="77" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Line x:Name="Bar4" X1="13" Y1="97" X2="43" Y2="67" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
            <StackPanel x:Name="Word" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,42,0,0" />
        </StackPanel>

        <!-- Current start-up step, shown only while it is still running -->
        <StackPanel x:Name="StatusPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,96" Opacity="0">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="NoWrap" />
        </StackPanel>

        <TextBlock x:Name="SkipHint" Text="Esc · Enter · A  to skip" Foreground="{StaticResource FaintBrush}" FontSize="12"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,34" Opacity="0" TextWrapping="NoWrap" />

        <!-- Start-up failure: reason and recovery hint -->
        <Grid x:Name="FailurePanel" Visibility="Collapsed" Background="#F2050607" Cursor="Arrow">
            <StackPanel MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="XBOX PC couldn't start" Style="{StaticResource Display}" FontSize="36" LineHeight="42" />
                <TextBlock x:Name="FailureText" Foreground="{StaticResource TextBrush}" FontSize="15" Margin="0,18,0,0" />
                <TextBlock x:Name="FailureHint" Style="{StaticResource Muted}" FontSize="14" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <Button x:Name="OpenFolderButton" Content="Open data folder" Style="{StaticResource SolidButton}" Command="{x:Static ApplicationCommands.Open}" />
                    <Button x:Name="CloseButton" Content="Close" Command="{x:Static ApplicationCommands.Close}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
