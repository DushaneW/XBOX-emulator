<Window x:Class="XboxPc.DesktopApp.MainWindow" Foreground="{StaticResource TextBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XboxPc.DesktopApp.ViewModels"
        xmlns:v="clr-namespace:XboxPc.DesktopApp.Views"
        Title="XBOX PC" Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><v:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecentViewModel}"><v:RecentView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmulatorViewModel}"><v:EmulatorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><v:PerformanceView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}" ClipToBounds="True">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ambient stage: the featured title's artwork, heavily blurred, fading into the dark -->
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Image x:Name="Backdrop" Source="{Binding BackdropPath, Converter={StaticResource Img}, ConverterParameter=480}" Stretch="UniformToFill" Opacity="0.30"
                   HorizontalAlignment="Right" Margin="0,-80,-80,0">
                <Image.Effect><BlurEffect Radius="90" KernelType="Gaussian" RenderingBias="Performance" /></Image.Effect>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400A0C0E" Offset="0" />
                        <GradientStop Color="#C00A0C0E" Offset="0.55" />
                        <GradientStop Color="#FF0A0C0E" Offset="0.9" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.85,0.05" GradientOrigin="0.85,0.05" RadiusX="0.9" RadiusY="0.8">
                        <GradientStop Color="#0DFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="56,22,56,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand: the aperture mark -->
            <Viewbox Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,30,0" ToolTip="XBOX PC">
                <Canvas Width="120" Height="120">
                    <Line X1="23" Y1="13" X2="53" Y2="43" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextBrush}" />
                    <Line X1="107" Y1="23" X2="77" Y2="53" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextBrush}" />
                    <Line X1="97" Y1="107" X2="67" Y2="77" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextBrush}" />
                    <Line X1="13" Y1="97" X2="43" Y2="67" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource AccentBrush}" />
                </Canvas>
            </Viewbox>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Badge}" Background="#14FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0" Padding="7,2" ToolTip="Previous section: LB or Page Up">
                    <TextBlock Text="LB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FaintBrush}" />
                </Border>
                <ItemsControl x:Name="NavItems" ItemsSource="{Binding Pages}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Key}"
                                         Content="{Binding Title}"
                                         AutomationProperties.Name="{Binding Title}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Badge}" Background="#14FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" Padding="7,2" ToolTip="Next section: RB or Page Down">
                    <TextBlock Text="RB" FontSize="11" FontWeight="Bold" Foreground="{StaticResource FaintBrush}" />
                </Border>
            </StackPanel>

            <!-- Controller, profile, clock -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,22,0"
                           ToolTip="{Binding ControllerStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ControllerConnected}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Grid Width="34" Height="34" VerticalAlignment="Center">
                    <Ellipse Fill="#2A3036" />
                    <TextBlock Text="{Binding ProfileInitial}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="10,0,24,0" TextWrapping="NoWrap" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource DisplayFont}" FontSize="17" VerticalAlignment="Center" TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <!-- Page -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage.ViewModel}" Focusable="False" Margin="56,22,56,0" />

        <!-- Dashboard frame stats (opt-in, Settings > Graphics) -->
        <TextBlock Grid.Row="1" Text="{Binding FrameStatsText}" Style="{StaticResource Mono}" Foreground="{StaticResource FaintBrush}"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="56,0,0,16" />

        <!-- Toast -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,32" Padding="18,12" CornerRadius="6"
                Background="#F21E2328" Opacity="0" IsHitTestVisible="False" MaxWidth="460">
            <Border.RenderTransform><TranslateTransform x:Name="ToastMove" Y="16" /></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Margin="0,0,14,0" />
                <TextBlock x:Name="ToastText" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
