<UserControl x:Class="XboxPc.DesktopApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Background="Transparent">
    <Grid>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Sections" Margin="0,0,0,40">

                <!-- ============ Featured title ============ -->
                <Grid x:Name="Hero" MinHeight="400" Margin="0,8,0,0" Visibility="{Binding HasFeatured, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,40,0">
                        <TextBlock Text="{Binding FeaturedEyebrow}" Style="{StaticResource Eyebrow}" FontSize="13" />
                        <TextBlock Text="{Binding Featured.Name}" Style="{StaticResource Display}" FontSize="58" LineHeight="62" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" MaxHeight="130" />
                        <WrapPanel Margin="0,18,0,0">
                            <TextBlock Text="{Binding Featured.GenerationText}" FontSize="15" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="  ·  " FontSize="15" Foreground="{StaticResource FaintBrush}" />
                            <TextBlock Text="{Binding Featured.StatusText}" FontSize="15" Foreground="{StaticResource MutedBrush}" ToolTip="Compatibility, from recorded test reports only" />
                            <TextBlock Text="  ·  " FontSize="15" Foreground="{StaticResource FaintBrush}" />
                            <TextBlock Text="{Binding Featured.PlayedAgo}" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,32,0,0">
                            <Button x:Name="HeroPlay" Style="{StaticResource PrimaryButton}" Command="{Binding PlayCommand}" CommandParameter="{Binding Featured}"
                                    Padding="30,13" FontSize="16" Visibility="{Binding Featured.CanPlay, Converter={StaticResource Vis}}" AutomationProperties.Name="Play">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#06120A" />
                                    <TextBlock Text="Play" VerticalAlignment="Center" Foreground="#06120A" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HeroDetails" Style="{StaticResource GhostButton}" Command="{Binding OpenGameCommand}" CommandParameter="{Binding Featured}"
                                    Padding="24,13" FontSize="16" Content="Game details" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="2,4,0,0" Visibility="{Binding Featured.CanPlay, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,3,10,0" />
                            <TextBlock Text="{Binding Featured.PlayBlock}" Style="{StaticResource Muted}" FontSize="13" MaxWidth="560" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Artwork, or the title's initials when there is none -->
                    <Grid Grid.Column="1" Width="276" Height="386" VerticalAlignment="Center">
                        <Border CornerRadius="8" Effect="{DynamicResource CardShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#262B31" Offset="0" />
                                    <GradientStop Color="#14171A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="{Binding Featured.Initials}" FontFamily="{StaticResource DisplayFont}" FontSize="110" FontWeight="Bold" Foreground="#30373D"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Featured.CoverPath, Converter={StaticResource Img}, ConverterParameter=600}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============ Empty library ============ -->
                <Grid x:Name="Welcome" Margin="0,24,0,0" Visibility="{Binding HasFeatured, Converter={StaticResource Vis}, ConverterParameter=Invert}">
                    <!-- Soft light behind the composition -->
                    <Ellipse Width="900" Height="520" VerticalAlignment="Top" Margin="0,-60,0,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A4FC36D" Offset="0" />
                                <GradientStop Color="#084FC36D" Offset="0.45" />
                                <GradientStop Color="#004FC36D" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- The aperture mark -->
                        <Viewbox Width="64" Height="64" HorizontalAlignment="Center">
                            <Canvas Width="120" Height="120">
                                <Line X1="23" Y1="13" X2="53" Y2="43" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextBrush}" />
                                <Line X1="107" Y1="23" X2="77" Y2="53" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextBrush}" />
                                <Line X1="97" Y1="107" X2="67" Y2="77" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextBrush}" />
                                <Line X1="13" Y1="97" X2="43" Y2="67" StrokeThickness="17" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource AccentBrush}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding Greeting}" Style="{StaticResource Eyebrow}" FontSize="14" HorizontalAlignment="Center" Margin="0,30,0,0" />
                        <TextBlock Text="Start your collection" Style="{StaticResource Display}" FontSize="58" LineHeight="62" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="17" Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Center" TextAlignment="Center"
                                   Text="Add an Original Xbox program (.xbe) to your library, or boot one straight away. You can also drop a default.xbe anywhere on this screen." />

                        <!-- Start actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,44,0,0">
                            <Button x:Name="WelcomeAdd" Command="{Binding AddGameCommand}" Width="270" Height="196" Padding="26,24" Margin="0,0,18,0"
                                    HorizontalContentAlignment="Left" AutomationProperties.Name="Add a game">
                                <StackPanel>
                                    <Grid Width="44" Height="44" HorizontalAlignment="Left">
                                        <Ellipse Fill="{StaticResource AccentBrush}" />
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="#06120A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Add a game" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,0" />
                                    <TextBlock Text="Pick an .xbe, name it, add your own cover." Style="{StaticResource Muted}" FontSize="13" FontWeight="Normal" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RunXbeCommand}" Width="270" Height="196" Padding="26,24" Margin="0,0,18,0"
                                    HorizontalContentAlignment="Left" AutomationProperties.Name="Boot an .xbe file">
                                <StackPanel>
                                    <Grid Width="44" Height="44" HorizontalAlignment="Left">
                                        <Ellipse Fill="#24FFFFFF" />
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Boot an .xbe file" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,0" />
                                    <TextBlock Text="Run a program once, without adding it." Style="{StaticResource Muted}" FontSize="13" FontWeight="Normal" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddSampleCommand}" Width="270" Height="196" Padding="26,24" Margin="0"
                                    HorizontalContentAlignment="Left" AutomationProperties.Name="Add the test program"
                                    ToolTip="An original test program bundled with XBOX PC. Not an Xbox game.">
                                <StackPanel>
                                    <Grid Width="44" Height="44" HorizontalAlignment="Left">
                                        <Ellipse Fill="#24FFFFFF" />
                                        <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Try the test program" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Margin="0,22,0,0" />
                                    <TextBlock Text="A bundled sample that runs right now." Style="{StaticResource Muted}" FontSize="13" FontWeight="Normal" Margin="0,6,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ============ Recently played ============ -->
                <StackPanel Margin="0,36,0,0" Visibility="{Binding HasRecentlyLaunched, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Command="{Binding SeeRecentCommand}" Content="See all" VerticalAlignment="Bottom" />
                        <TextBlock Text="Recently played" Style="{StaticResource RowTitle}" />
                    </DockPanel>
                    <ScrollViewer Style="{StaticResource TileRow}">
                        <ItemsControl ItemsSource="{Binding RecentlyLaunched}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CoverTile}" Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ My games ============ -->
                <StackPanel Margin="0,30,0,0" Visibility="{Binding HasGames, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Command="{Binding SeeAllCommand}" Content="See all" VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="My games" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding LibraryCountText}" Foreground="{StaticResource FaintBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,2" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Style="{StaticResource TileRow}">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Collection}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource CoverTile}" Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Command="{Binding AddGameCommand}" Width="176" Margin="0" AutomationProperties.Name="Add a game" Background="#0DFFFFFF" VerticalAlignment="Top" Padding="0">
                                <Grid Height="246">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="Add a game" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- ============ System status: one quiet line ============ -->
                <Button Command="{Binding GoEmulatorCommand}" FontWeight="Normal" ToolTip="{Binding KernelTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TextButton}">
                            <Setter Property="Margin" Value="0,30,0,0" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFeatured}" Value="False">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,64,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent2Brush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding CoreText}" FontSize="13" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="  ·  kernel " FontSize="13" TextWrapping="NoWrap" Foreground="{StaticResource FaintBrush}" />
                        <TextBlock Text="{Binding KernelSummary}" FontSize="13" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="  ·  no BIOS needed" FontSize="13" TextWrapping="NoWrap" Foreground="{StaticResource FaintBrush}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Drop target feedback -->
        <Border x:Name="DropOverlay" Background="#E60A0C0E" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False" Margin="0,0,0,24">
            <Grid>
                <Rectangle x:Name="DropBorder" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="5 4" Stroke="{StaticResource AccentBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DropTitle" Text="Release to boot" Style="{StaticResource Display}" FontSize="34" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropHint" Text="The emulator window opens" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
