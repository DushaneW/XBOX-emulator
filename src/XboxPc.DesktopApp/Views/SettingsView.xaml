<UserControl x:Class="XboxPc.DesktopApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XboxPc.DesktopApp.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sections -->
        <StackPanel Margin="0,8,40,0">
            <TextBlock Text="Settings" Style="{StaticResource Display}" FontSize="40" LineHeight="44" Margin="0,0,0,28" />
            <RadioButton Style="{StaticResource SideItem}" GroupName="set" Content="General" Command="{Binding SetSectionCommand}" CommandParameter="general"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource EqB}, ConverterParameter=general}" />
            <RadioButton Style="{StaticResource SideItem}" GroupName="set" Content="Input" Command="{Binding SetSectionCommand}" CommandParameter="input"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource EqB}, ConverterParameter=input}" />
            <RadioButton Style="{StaticResource SideItem}" GroupName="set" Content="Graphics" Command="{Binding SetSectionCommand}" CommandParameter="graphics"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource EqB}, ConverterParameter=graphics}" />
            <RadioButton Style="{StaticResource SideItem}" GroupName="set" Content="Audio" Command="{Binding SetSectionCommand}" CommandParameter="audio"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource EqB}, ConverterParameter=audio}" />
            <RadioButton Style="{StaticResource SideItem}" GroupName="set" Content="Profiles" Command="{Binding SetSectionCommand}" CommandParameter="profiles"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource EqB}, ConverterParameter=profiles}" />
            <RadioButton Style="{StaticResource SideItem}" GroupName="set" Content="Emulator" Command="{Binding SetSectionCommand}" CommandParameter="emulator"
                         IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource EqB}, ConverterParameter=emulator}" />
            <TextBlock Text="{Binding SavedText}" Style="{StaticResource Muted}" FontSize="12" Margin="18,24,0,0" />
            <TextBlock Text="Changes apply and save as you make them." Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="18,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,24,40">
            <Grid MaxWidth="840" HorizontalAlignment="Left">

                <!-- ===================== General ===================== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=general}">
                    <TextBlock Text="START-UP" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding StartupAnimation}" AutomationProperties.Name="Start-up animation" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Start-up animation" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The XBOX PC logo sequence when the app opens. Off: the dashboard appears as soon as your library is loaded." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding StartupSound}" AutomationProperties.Name="Start-up sound" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Start-up sound" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="A short chime with the logo, at the volume set under Audio." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="DISPLAY" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DashboardFullscreen}" AutomationProperties.Name="Full screen dashboard" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Full screen" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Show the dashboard full screen. F11 switches at any time." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Width="260" VerticalAlignment="Top">
                            <Slider Minimum="0.75" Maximum="1.75" SmallChange="0.05" LargeChange="0.25" Value="{Binding UiScale}" AutomationProperties.Name="Interface size" />
                            <TextBlock Text="{Binding UiScaleText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Interface size" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Makes everything larger for viewing from the couch." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ReduceMotion}" AutomationProperties.Name="Reduce motion" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Reduce motion" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Replaces movement with simple fades. Also follows the Windows animation setting." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock DockPanel.Dock="Right" Text="English" FontSize="15" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Language" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="English is the only language in this version." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock DockPanel.Dock="Right" Text="Dark" FontSize="15" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Theme" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The dashboard has one dark theme." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- ===================== Input ===================== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=input}">
                    <TextBlock Text="IN GAMES" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Content="Configure" Command="{Binding GameInputCommand}" VerticalAlignment="Top" Margin="0" />
                        <StackPanel>
                            <TextBlock Text="Controller, keyboard and mouse" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The default for every game: Xbox controller, keyboard and mouse, or both together (hybrid); key and button bindings, mouse sensitivity, stick dead zones and vibration. A game can have its own profile: open it in My Games and choose Input settings."
                                       Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="CONTROLLERS" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding ControllerApiText}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding Slots}" Focusable="False" Margin="0,0,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SlotText}" Width="80" Style="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Status}" Width="130" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="DASHBOARD NAVIGATION" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Width="260" VerticalAlignment="Top">
                            <Slider Minimum="5" Maximum="60" SmallChange="1" LargeChange="5" Value="{Binding DeadZonePercent}" AutomationProperties.Name="Stick dead zone" />
                            <TextBlock Text="{Binding DeadZoneText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Stick dead zone" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="How far the left stick must move before the dashboard reacts." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Width="260" VerticalAlignment="Top">
                            <Slider Minimum="0.5" Maximum="2" SmallChange="0.05" LargeChange="0.25" Value="{Binding Sensitivity}" AutomationProperties.Name="Stick sensitivity" />
                            <TextBlock Text="{Binding SensitivityText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Stick sensitivity" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Repeat speed when the stick is held." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Action" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="1" Text="Controller" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="2" Text="Keyboard" Style="{StaticResource Eyebrow}" Margin="10,0,0,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Mappings}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="190" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" FontSize="14" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.PadOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Pad}" MinWidth="0" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.KeyOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Key}" MinWidth="0" Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding InputErrors}" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0" Visibility="{Binding HasInputErrors, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding InputSavedText}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" Visibility="{Binding InputSavedText, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource SolidButton}" Content="Save mapping" Command="{Binding SaveInputCommand}" />
                        <Button Content="Restore defaults" Command="{Binding ResetInputCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- ===================== Graphics ===================== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=graphics}">
                    <TextBlock Text="EMULATED PICTURE" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource Accent2SoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Experimental" Foreground="{StaticResource Accent2Brush}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <ComboBox ItemsSource="{Binding Renderers}" SelectedItem="{Binding Renderer}" DisplayMemberPath="Label" Width="260" AutomationProperties.Name="Renderer" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Renderer" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Direct3D 12 renders games on your graphics card at the resolution below. If it is unavailable or fails, the CPU renderer takes over." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}" IsEnabled="{Binding IsGpuRenderer}">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" DisplayMemberPath="Label" Width="300" VerticalAlignment="Top" AutomationProperties.Name="Resolution" />
                        <StackPanel>
                            <TextBlock Text="Resolution" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Renders the game's 3D at a multiple of its own resolution: sharper edges and textures. Applies to the next game you start." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding KeepAspectRatio}" AutomationProperties.Name="Keep 4:3 picture" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Keep the original shape" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Black bars keep the game's own proportions. Off: the picture is stretched to fill the window." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding SmoothScaling}" AutomationProperties.Name="Smooth scaling" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Smooth scaling" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Filter the picture when it is enlarged. Off: sharp pixels." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding LaunchFullscreen}" AutomationProperties.Name="Games start full screen" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Start games full screen" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="F11 switches while playing." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="DASHBOARD" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" DisplayMemberPath="Label" Width="300" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Dashboard quality" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Shadows, image filtering, the blurred backdrop and animations of this app. Does not affect games." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowFrameStats}" AutomationProperties.Name="Show dashboard frame rate" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Show dashboard frame rate" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="A small counter at the bottom of the dashboard. It measures this app's interface, never a game." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- ===================== Audio ===================== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=audio}">
                    <TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Width="300" VerticalAlignment="Top">
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding Volume}" AutomationProperties.Name="Volume" />
                            <TextBlock Text="{Binding VolumeText}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Volume" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Game audio and the start-up sound. Applies to the next game you start." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <Button DockPanel.Dock="Right" Content="Play" Command="{Binding PreviewSoundCommand}" VerticalAlignment="Top" Margin="0" />
                        <StackPanel>
                            <TextBlock Text="Hear the start-up sound" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Plays the chime once at this volume." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock DockPanel.Dock="Right" Text="{x:Static vm:SettingsViewModel.AudioDeviceText}" FontSize="15" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Output device" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="Choosing a different device is not available yet; change the default device in Windows." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock DockPanel.Dock="Right" Text="{x:Static vm:SettingsViewModel.AudioBackendText}" FontSize="14" VerticalAlignment="Top" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel>
                            <TextBlock Text="Backend and latency" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="The emulated AC97 output is streamed in 20 ms blocks. Fixed in this version." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- ===================== Profiles ===================== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=profiles}">
                    <TextBlock Text="{Binding ActiveProfileText}" Style="{StaticResource H2}" Margin="0,8,0,16" />
                    <TextBlock Text="Each profile keeps its own settings, dashboard mapping and per-game settings." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18" />
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName" MaxHeight="240" Width="420" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource SolidButton}" Content="Switch to this profile" Command="{Binding SwitchProfileCommand}" />
                        <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteProfileCommand}" />
                    </StackPanel>
                    <TextBlock Text="Rename" Style="{StaticResource Label}" Margin="0,22,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="New name" />
                        <Button Content="Rename" Command="{Binding RenameProfileCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="New profile" Style="{StaticResource Label}" Margin="0,22,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="Profile name" />
                        <Button Content="Create" Command="{Binding CreateProfileCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ===================== Emulator ===================== -->
                <Grid Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=emulator}">
                <StackPanel DataContext="{Binding DataContext.Emulator, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Text="ORIGINAL XBOX CORE" Style="{StaticResource SectionTitle}" />
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Style="{StaticResource Badge}" Background="{StaticResource Accent2SoftBrush}" Margin="0,0,12,0">
                                <TextBlock Text="{Binding CoreState}" Foreground="{StaticResource Accent2Brush}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding CoreVersion}" Style="{StaticResource Mono}" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Runtime version" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding Core.Summary}" Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock DockPanel.Dock="Right" Text="Not required" FontSize="15" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="BIOS and firmware" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{x:Static vm:EmulatorViewModel.FirmwareText}" Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock DockPanel.Dock="Right" Text="{x:Static vm:EmulatorViewModel.KernelText}" FontSize="15" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="Kernel" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="High-level emulation. A program that calls an export that is not implemented stops and names it." Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,10,0" />
                            <Button Content="Open data folder" Command="{Binding OpenDataCommand}" Margin="0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Logs and data" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SettingNote}" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="Compatibility" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{x:Static vm:EmulatorViewModel.CompatibilityText}" Style="{StaticResource SettingNote}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="More detail, including what each part of the console emulates, is on the Emulator page." Foreground="{StaticResource FaintBrush}" FontSize="13" />
                </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
