<Window x:Class="XboxPc.DesktopApp.Views.EmulatorWindow" Foreground="{StaticResource TextBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XBOX PC" Width="1280" Height="800" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="Black" UseLayoutRounding="True"
        FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <!-- In-game menu entry: full width; focused = white bar with dark text (console style) -->
        <Style x:Key="MenuEntry" TargetType="Button" BasedOn="{StaticResource BaseControl}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="18,12">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F2F4F5" /><Setter Property="Foreground" Value="#0A0C0E" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="18,6,0,6" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- The emulated picture: nothing else on screen while playing -->
        <Grid x:Name="ViewHost" Background="Black" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Arrow">
            <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Grid>

        <!-- Hint: how to capture the mouse / open the menu -->
        <Border x:Name="Hint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,8" CornerRadius="16" Background="#CC0A0C0E"
                IsHitTestVisible="False" Opacity="0">
            <TextBlock x:Name="HintText" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="NoWrap" />
        </Border>

        <!-- Mouse users: a menu button that shows while the pointer moves over the picture (F1 / Back + Start do the same) -->
        <Button x:Name="MenuButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0"
                Padding="14,8" Opacity="0" Click="OnMenuButtonClick" AutomationProperties.Name="Open menu" Background="#CC0A0C0E">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Menu" VerticalAlignment="Center" />
                <TextBlock Text="  F1" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" FontWeight="Normal" />
            </StackPanel>
        </Button>

        <!-- Performance stats (in-game menu > Performance stats) -->
        <Border x:Name="Hud" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Padding="12,8" CornerRadius="6" Background="#B3000000"
                IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="HudText" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="NoWrap" />
        </Border>

        <!-- Launch transition: the title's artwork until the first real frame -->
        <Grid x:Name="Curtain" Background="{StaticResource BgBrush}">
            <Image x:Name="CurtainArt" Stretch="UniformToFill" Opacity="0.35">
                <Image.Effect><BlurEffect Radius="70" /></Image.Effect>
            </Image>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush RadiusX="0.75" RadiusY="0.75">
                        <GradientStop Color="#400A0C0E" Offset="0" />
                        <GradientStop Color="#F00A0C0E" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel x:Name="CurtainContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="200" Height="280" HorizontalAlignment="Center">
                    <Border CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#262B31" Offset="0" />
                                <GradientStop Color="#14171A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="CurtainInitials" FontFamily="{StaticResource DisplayFont}" FontSize="80" FontWeight="Bold" Foreground="#30373D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                    </Border>
                    <Border x:Name="CurtainCover" CornerRadius="8" />
                </Grid>
                <TextBlock x:Name="CurtainTitle" Style="{StaticResource Display}" FontSize="38" LineHeight="42" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,30,0,0" MaxWidth="760" />
                <TextBlock Text="Original Xbox  ·  Experimental emulator" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0">
                    <Ellipse x:Name="CurtainDot" Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="CurtainStatus" Text="Starting" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- The title stopped: reason and diagnostics -->
        <Grid x:Name="Failure" Visibility="Collapsed" Background="#F20A0C0E">
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <TextBlock x:Name="FailTitle" Style="{StaticResource Display}" FontSize="40" LineHeight="44" />
                <TextBlock x:Name="FailReason" FontSize="16" Margin="0,16,0,0" />
                <TextBlock x:Name="FailHint" Style="{StaticResource Muted}" FontSize="14" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                    <Button x:Name="FailExit" Style="{StaticResource SolidButton}" Content="Exit to dashboard" Click="OnExitClick" Padding="24,12" />
                    <Button x:Name="FailDiag" Style="{StaticResource GhostButton}" Content="Show diagnostics" Click="OnFailDiagnosticsClick" Padding="22,12" />
                </StackPanel>
                <TextBox x:Name="FailDebug" Visibility="Collapsed" IsReadOnly="True" Height="220" Margin="0,18,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" />
            </StackPanel>
        </Grid>

        <!-- In-game menu -->
        <Grid x:Name="Menu" Visibility="Collapsed">
            <Rectangle x:Name="MenuScrim" Fill="#A6000000" MouseDown="OnScrimMouseDown" />
            <Border x:Name="MenuPanel" Width="420" HorizontalAlignment="Left" Background="#F5101316" Padding="30,36,30,26">
                <Border.RenderTransform><TranslateTransform x:Name="MenuMove" /></Border.RenderTransform>
                <DockPanel>
                    <!-- Header: what is running and its real state -->
                    <DockPanel DockPanel.Dock="Top" Margin="18,0,0,28">
                        <Grid Width="56" Height="78" DockPanel.Dock="Left" Margin="0,0,16,0">
                            <Border CornerRadius="5" Background="#262B31">
                                <TextBlock x:Name="MenuInitials" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="#3A4148"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap" />
                            </Border>
                            <Border x:Name="MenuCover" CornerRadius="5" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="MenuTitle" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxHeight="56" />
                            <TextBlock x:Name="MenuState" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="A / Enter  select     B / Esc  back     F1 or Back + Start  menu" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="18,18,0,0" TextWrapping="Wrap" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="MenuItems" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <Button x:Name="ResumeItem" Style="{StaticResource MenuEntry}" Content="Resume" Click="OnResumeClick" />
                            <Button x:Name="PauseItem" Style="{StaticResource MenuEntry}" Content="Pause" Click="OnPauseClick" />
                            <Button Style="{StaticResource MenuEntry}" Content="Input settings" Click="OnInputClick" />

                            <TextBlock Text="GRAPHICS" Style="{StaticResource Eyebrow}" Margin="18,18,0,6" />
                            <CheckBox x:Name="AspectToggle" Style="{StaticResource MenuToggle}" Content="Keep the original shape" Checked="OnPictureChanged" Unchecked="OnPictureChanged" />
                            <CheckBox x:Name="SmoothToggle" Style="{StaticResource MenuToggle}" Content="Smooth scaling" Checked="OnPictureChanged" Unchecked="OnPictureChanged" />
                            <CheckBox x:Name="FullscreenToggle" Style="{StaticResource MenuToggle}" Content="Full screen" Checked="OnFullscreenToggled" Unchecked="OnFullscreenToggled" />

                            <TextBlock Text="SESSION" Style="{StaticResource Eyebrow}" Margin="18,18,0,6" />
                            <CheckBox x:Name="StatsToggle" Style="{StaticResource MenuToggle}" Content="Performance stats" Checked="OnStatsToggled" Unchecked="OnStatsToggled" />
                            <CheckBox x:Name="MuteToggle" Style="{StaticResource MenuToggle}" Content="Mute" Checked="OnMuteToggled" Unchecked="OnMuteToggled" />
                            <Button Style="{StaticResource MenuEntry}" Content="Take screenshot" Click="OnScreenshotClick" Margin="0,10,0,4" />
                            <Button x:Name="DiagItem" Style="{StaticResource MenuEntry}" Content="Diagnostics" Click="OnDiagnosticsClick" />
                            <Button Style="{StaticResource MenuEntry}" Content="Exit to dashboard" Click="OnExitClick" Margin="0,14,0,0" />
                            <TextBlock x:Name="MenuMessage" Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="18,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Diagnostics: the title's own debug output and unmodelled hardware -->
            <Border x:Name="DiagPanel" Visibility="Collapsed" Margin="444,36,36,36" Background="#F5101316" CornerRadius="8" Padding="24,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Diagnostics" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" x:Name="DiagStats" Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,8,0,14" />
                    <TextBox x:Name="DebugText" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Background="#0A0C0E" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
