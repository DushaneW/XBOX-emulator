<UserControl x:Class="XboxPc.DesktopApp.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XboxPc.DesktopApp.ViewModels">
    <UserControl.Resources>
        <!-- A headline number. The note (what it measures) is the tooltip and a line under it. -->
        <DataTemplate x:Key="Stat" DataType="{x:Type vm:StatTile}">
            <StackPanel Margin="0,0,30,30" ToolTip="{Binding Note}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="NoWrap" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Unit}" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,9" TextWrapping="NoWrap" />
                </StackPanel>
                <TextBlock Text="{Binding Note}" Foreground="{StaticResource FaintBrush}" FontSize="12" MaxWidth="240" HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,8,24,40" MaxWidth="1160" HorizontalAlignment="Left">
            <TextBlock Text="Performance" Style="{StaticResource Display}" FontSize="40" LineHeight="44" />
            <TextBlock Text="Live measurements from the running game and this PC." Style="{StaticResource Muted}" FontSize="15" Margin="0,8,0,0" />

            <!-- ===================== Game ===================== -->
            <DockPanel Margin="0,40,0,20">
                <TextBlock DockPanel.Dock="Right" Text="{Binding BackendText}" Foreground="{StaticResource FaintBrush}" FontSize="13" VerticalAlignment="Bottom" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Game" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="{Binding GameTitle}" FontSize="15" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="14,0,0,2" TextWrapping="NoWrap" />
                    <Border Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Bottom" Visibility="{Binding GameState, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding GameState}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Game}" ItemTemplate="{StaticResource Stat}" Focusable="False"
                          Visibility="{Binding IsGameRunning, Converter={StaticResource Vis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Visibility="{Binding IsGameRunning, Converter={StaticResource Vis}, ConverterParameter=Invert}" Style="{StaticResource Muted}" FontSize="15" MaxWidth="720" HorizontalAlignment="Left"
                       Text="No game is running. Game frame rate, frame time, emulation speed and emulated CPU speed appear here while a game plays." />

            <!-- ===================== This PC ===================== -->
            <TextBlock Text="This PC" Style="{StaticResource RowTitle}" Margin="0,40,0,20" />
            <ItemsControl ItemsSource="{Binding Host}" ItemTemplate="{StaticResource Stat}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="CPU and GPU temperatures are not shown: Windows offers no supported way to read them without a vendor driver." Foreground="{StaticResource FaintBrush}" FontSize="12" />

            <!-- ===================== Dashboard ===================== -->
            <TextBlock Text="Dashboard rendering" Style="{StaticResource RowTitle}" Margin="0,44,0,6" />
            <TextBlock Text="How smoothly this app's own interface draws. This is not a game's frame rate." Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,18" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Metrics[0].Name}" Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="{Binding Metrics[0].Value}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Metrics[0].Note}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,0,20,10" />
                    <TextBlock Text="{Binding Metrics[1].Name}" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Metrics[1].Value}" FontSize="15" Margin="0,4,0,0" />
                    <Button Content="{Binding FrameButtonText}" Command="{Binding ToggleFramesCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#0DFFFFFF" CornerRadius="6" Padding="16" Height="168" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="Frame time (ms), lower is smoother · 50 ms scale" Foreground="{StaticResource FaintBrush}" FontSize="11" VerticalAlignment="Top" />
                        <Viewbox Stretch="Fill" Margin="0,18,0,0">
                            <Canvas Width="600" Height="120">
                                <Line X1="0" X2="600" Y1="80" Y2="80" Stroke="#22FFFFFF" StrokeDashArray="3 4" ToolTip="16.7 ms (60 fps)" />
                                <Polyline Points="{Binding Graph}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Start frame measurement to draw the graph." Foreground="{StaticResource FaintBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsMeasuringFrames, Converter={StaticResource Vis}, ConverterParameter=Invert}" />
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Text="{x:Static vm:PerformanceViewModel.FrameNote}" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="0,14,0,0" MaxWidth="900" HorizontalAlignment="Left" />

            <!-- ===================== Recording ===================== -->
            <TextBlock Text="Recording" Style="{StaticResource RowTitle}" Margin="0,44,0,12" />
            <TextBlock Text="{Binding RecordText}" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,14" />
            <WrapPanel>
                <Button Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" />
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
                <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" />
                <Button Style="{StaticResource GhostButton}" Content="Clear" Command="{Binding ClearCommand}" />
            </WrapPanel>

            <!-- ===================== Displays + every counter ===================== -->
            <DockPanel Margin="0,40,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Refresh" Command="{Binding RefreshDisplaysCommand}" VerticalAlignment="Bottom" />
                <TextBlock Text="Displays" Style="{StaticResource RowTitle}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Displays}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding AdapterName}" FontWeight="SemiBold" Width="320" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}">
                                <Run Text="{Binding Width, Mode=OneWay}" /><Run Text=" x " /><Run Text="{Binding Height, Mode=OneWay}" /><Run Text=" @ " /><Run Text="{Binding RefreshHz, Mode=OneWay}" /><Run Text=" Hz" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="All counters" Style="{StaticResource RowTitle}" Margin="0,40,0,14" />
            <ItemsControl ItemsSource="{Binding Metrics}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="13" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{Binding Note}" Foreground="{StaticResource FaintBrush}" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
