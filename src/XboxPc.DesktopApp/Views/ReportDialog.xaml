<Window x:Class="XboxPc.DesktopApp.Views.ReportDialog" Foreground="{StaticResource TextBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:XboxPc.DesktopApp"
        Title="Add compatibility test report" Width="780" Height="860" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <app:VisibilityConverter x:Key="Vis" />
    </Window.Resources>
    <DockPanel Margin="24,20">
        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Content="Save report" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Errors}" Foreground="{StaticResource WarnBrush}" Visibility="{Binding HasErrors, Converter={StaticResource Vis}}" Margin="0,8,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding GameName, StringFormat=Test report: {0}}" Style="{StaticResource H2}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Muted}" FontSize="12">
                    Record only what you observed. Any status above "Researching" requires a test asset hash, the exact procedure, at least one evidence reference and a confirming reviewer.
                </TextBlock>

                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Observed outcome" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Outcomes}" SelectedItem="{Binding Outcome}" DisplayMemberPath="Label" MinWidth="220" AutomationProperties.Name="Outcome" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Source" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" DisplayMemberPath="Label" MinWidth="300" AutomationProperties.Name="Report source" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Runtime ID" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding RuntimeId, UpdateSourceTrigger=PropertyChanged}" Width="300" AutomationProperties.Name="Runtime ID" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Runtime build / version" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding RuntimeVersion, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Runtime version" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Test asset fingerprint (hash)" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Compute SHA-256" Command="{Binding ComputeHashCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding Fingerprint, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="Fingerprint" />
                </DockPanel>

                <TextBlock Text="Exact test procedure" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Procedure, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="Procedure" />

                <WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Average FPS (only if measured)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding AverageFps, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="Average FPS" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Audio result" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Audio, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Audio result" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Input result" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding InputResult, UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Input result" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="Graphics issues (one per line)" Style="{StaticResource Label}" />
                <TextBox Text="{Binding GraphicsIssues, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" AutomationProperties.Name="Graphics issues" />
                <TextBlock Text="Crash details (redacted automatically)" Style="{StaticResource Label}" />
                <TextBox Text="{Binding CrashDetails, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" AutomationProperties.Name="Crash details" />

                <TextBlock Text="Evidence references (log files, screenshots, videos, one per line)" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add file..." Command="{Binding AddEvidenceFileCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
                    <TextBox Text="{Binding Evidence, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" AutomationProperties.Name="Evidence" />
                </DockPanel>

                <WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Reviewer" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Reviewer, UpdateSourceTrigger=PropertyChanged}" Width="240" AutomationProperties.Name="Reviewer" />
                    </StackPanel>
                    <CheckBox Content="I, the reviewer, confirm this result was observed as described" IsChecked="{Binding ReviewerConfirmed}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </WrapPanel>

                <TextBlock Text="Reproducibility notes" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" AutomationProperties.Name="Reproducibility notes" />

                <TextBlock Text="Host (collected automatically)" Style="{StaticResource Label}" />
                <TextBox Text="{Binding HostText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
