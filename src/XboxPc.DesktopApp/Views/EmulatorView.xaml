<UserControl x:Class="XboxPc.DesktopApp.Views.EmulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XboxPc.DesktopApp.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,8,24,40" MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="ORIGINAL XBOX" Style="{StaticResource Eyebrow}" FontSize="13" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Emulator" Style="{StaticResource Display}" FontSize="46" LineHeight="50" />
                <Border Style="{StaticResource Badge}" Background="{StaticResource Accent2SoftBrush}" VerticalAlignment="Center" Margin="20,8,0,0" Padding="10,4">
                    <TextBlock Text="{Binding CoreState}" Foreground="{StaticResource Accent2Brush}" FontWeight="SemiBold" FontSize="13" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding Core.Summary}" Style="{StaticResource Muted}" FontSize="16" Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <Button Style="{StaticResource SolidButton}" Command="{Binding RunXbeCommand}" Padding="22,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#0A0C0E" />
                        <TextBlock Text="Boot an .xbe file" Foreground="#0A0C0E" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Content="Technical notes" Command="{Binding OpenCoreDocsCommand}" Padding="20,12" />
            </StackPanel>

            <!-- Key facts -->
            <Grid Margin="0,44,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Version" Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="{Binding CoreVersion}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Version, StringFormat='App {0}'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,30,0">
                    <TextBlock Text="Kernel" Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="{x:Static vm:EmulatorViewModel.KernelText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="NoWrap" />
                    <Grid Width="200" Height="4" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Border Background="#2A3036" CornerRadius="2" />
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left"
                                Width="{Binding Source={x:Static vm:EmulatorViewModel.KernelFraction}, Converter={StaticResource Frac}, ConverterParameter=200}" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,30,0">
                    <TextBlock Text="BIOS / firmware" Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="Not required" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="NoWrap" />
                    <TextBlock Text="High-level kernel emulation" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="EEPROM" Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="Blank" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="NoWrap" />
                    <TextBlock Text="No console keys" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Hardware -->
            <TextBlock Text="What is emulated" Style="{StaticResource RowTitle}" Margin="0,52,0,18" />
            <ItemsControl ItemsSource="{x:Static vm:EmulatorViewModel.Hardware}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,7,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource FaintBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Implemented}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Compatibility" Style="{StaticResource RowTitle}" Margin="0,34,0,10" />
            <TextBlock Text="{x:Static vm:EmulatorViewModel.CompatibilityText}" Style="{StaticResource Muted}" FontSize="15" MaxWidth="820" HorizontalAlignment="Left" />

            <!-- Other runtimes -->
            <TextBlock Text="Other consoles" Style="{StaticResource RowTitle}" Margin="0,44,0,18" />
            <ItemsControl ItemsSource="{Binding OtherRuntimes}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="212" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="14" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource TextButton}" Content="Why Xbox Series X|S software cannot run" Command="{Binding OpenFeasibilityCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />

            <!-- Log -->
            <DockPanel Margin="0,48,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshLogCommand}" Margin="0,0,10,0" />
                    <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" Margin="0" />
                </StackPanel>
                <TextBlock Text="Recent log" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="#0DFFFFFF" CornerRadius="6" Padding="16,12">
                <ItemsControl ItemsSource="{Binding RecentLog}" Focusable="False" MaxHeight="260">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" Width="76" />
                                <TextBlock Text="{Binding Level}" Style="{StaticResource Mono}" Width="100" />
                                <TextBlock Text="{Binding Category}" Style="{StaticResource Mono}" Width="110" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{x:Static vm:EmulatorViewModel.Statement}" Foreground="{StaticResource FaintBrush}" FontSize="13" Margin="0,36,0,0" MaxWidth="860" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
