XPCT 1
; Original XBOX PC test program: prints the first 30 Fibonacci numbers.
.name Fibonacci (30 values)
    set r0 0        ; a
    set r1 1        ; b
    set r2 30       ; counter
loop:
    out r0
    mov r3 r1
    add r1 r0       ; b = a + b
    mov r0 r3       ; a = old b
    dec r2
    jnz r2 loop
    halt
